{
  "compilerOptions": {
    "strict": false,
    "strictPropertyInitialization": false,
    "noUnusedLocals": true,
    "rootDir": ".",
    "removeComments": true,
    "outDir": "../dist",
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "useDefineForClassFields": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "sourceMap": false,
    "noEmitHelpers": false,
    "noImplicitAny": false,
    "declaration": true,
    "skipLibCheck": true,
    "stripInternal": true,
    "noUnusedParameters": false,
    "lib": ["dom", "ES2022"]
  },
  "exclude": [
    "**/node_modules",
    "../node_modules",
    "**/*.spec.ts"
  ],
  "angularCompilerOptions": {
    "compilationMode": "partial"
  }
}