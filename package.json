{
  "name": "@deliverysolutions/agm-overlays",
  "version": "2.0.0",
  "description": "Custom marker overlay for the @agm/core package",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "npm-run-all build:dist:js update:dist build:example",
    "build:dist:js": "ng-packagr -p ng-package.json -c src/tsconfig.json",
    "update:dist": "node scripts/update-dist-package.js",
    "build:example": "ng build example --configuration=production",
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "npm run watch",
    "watch": "ng serve example --port 4202 --open"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ackerapple/agm-overlays.git"
  },
  "keywords": [
    "agm",
    "overlay",
    "custom",
    "markers",
    "google",
    "maps"
  ],
  "author": "Acker Apple",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ackerapple/agm-overlays/issues"
  },
  "homepage": "https://github.com/ackerapple/agm-overlays#readme",
  "peerDependencies": {
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@grupo-san-cristobal/agm-core": "^20.0.2",
    "rxjs": "^6.5.3 || ^7.4.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.1.8",
    "@angular/cli": "22.1.8",
    "@angular/common": "22.1.7",
    "@angular/compiler": "22.1.7",
    "@angular/compiler-cli": "22.1.7",
    "@angular/core": "22.1.7",
    "@angular/platform-browser": "22.1.7",
    "@angular/platform-browser-dynamic": "22.1.7",
    "@google/markerclustererplus": "^5.0.4",
    "@grupo-san-cristobal/agm-core": "20.0.2",
    "@grupo-san-cristobal/agm-markerclusterer": "20.0.2",
    "@types/google.maps": "^3.53.4",
    "js-marker-clusterer": "^1.0.0",
    "ng-packagr": "22.1.0",
    "npm-run-all": "^4.1.5",
    "reflect-metadata": "^0.1.13",
    "rxjs": "7.8.2",
    "typescript": "6.0.3",
    "zone.js": "~0.16.0"
  },
  "private": true,
  "ngPackage": {
    "lib": {
      "entryFile": "src/index.ts"
    }
  }
}
